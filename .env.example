# Copy this file to .env and replace the placeholder with a real key.
AGENTOPS_PRIMARY_ENDPOINT=https://nexaxis.ai/v1/chat/completions
AGENTOPS_PRIMARY_API_KEY=replace-me
AGENTOPS_PRIMARY_MODEL=gpt-5.4
AGENTOPS_MAX_RETRIES=1
AGENTOPS_BACKOFF_MILLIS=250
AGENTOPS_PROVIDER_TIMEOUT_MILLIS=60000
AGENTOPS_BREAKER_THRESHOLD=2
AGENTOPS_REDIS_URL=redis://localhost:6379
AGENTOPS_IDEMPOTENCY_TTL_SECONDS=86400
